# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=acscp

# Server Configuration
PORT=3000
POLICY_MODE=adaptive

# Phase 4 Keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-me
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ac-scp-realm
KEYCLOAK_ISSUER=http://localhost:8080/realms/ac-scp-realm
KEYCLOAK_API_CLIENT_ID=acscp-api
KEYCLOAK_SERVICE_CLIENT_ID=risk-engine-service
KEYCLOAK_SERVICE_CLIENT_SECRET=replace-with-the-imported-client-secret
KEYCLOAK_ACCESS_TOKEN_LIFESPAN_SEC=60
KEYCLOAK_PRIVILEGED_ROLES=admin_access
REVOCATION_CHECK=backchannel
KEYCLOAK_SIM_PASSWORD=sim-password
