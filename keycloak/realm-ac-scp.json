{
  "realm": "ac-scp-realm",
  "enabled": true,
  "accessTokenLifespan": 60,
  "requiredCredentials": ["password"],
  "roles": {
    "realm": [
      { "name": "developer" },
      { "name": "analyst" },
      { "name": "admin_access" }
    ]
  },
  "requiredActions": [
    { "alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": false, "defaultAction": false, "priority": 10 },
    { "alias": "VERIFY_EMAIL", "name": "Verify Email", "providerId": "VERIFY_EMAIL", "enabled": false, "defaultAction": false, "priority": 50 },
    { "alias": "UPDATE_PROFILE", "name": "Update Profile", "providerId": "UPDATE_PROFILE", "enabled": false, "defaultAction": false, "priority": 20 },
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": false, "defaultAction": false, "priority": 30 },
    { "alias": "terms_and_conditions", "name": "Terms and Conditions", "providerId": "terms_and_conditions", "enabled": false, "defaultAction": false, "priority": 40 }
  ],
  "clients": [
    {
      "clientId": "acscp-api",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "attributes": {
        "backchannel.logout.url": "http://host.docker.internal:3000/internal/backchannel-logout",
        "backchannel.logout.session.required": "true"
      },
      "protocolMappers": [
        {
          "name": "acscp-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "acscp-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "risk-engine-service",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "change-me-risk-engine-service",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["profile", "email"]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Developer",
      "email": "alice@example.com",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "alice-password", "temporary": false }],
      "realmRoles": ["developer"]
    },
    {
      "username": "bob",
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Analyst",
      "email": "bob@example.com",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "bob-password", "temporary": false }],
      "realmRoles": ["analyst"]
    },
    {
      "username": "carol",
      "enabled": true,
      "firstName": "Carol",
      "lastName": "Admin",
      "email": "carol@example.com",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{ "type": "password", "value": "carol-password", "temporary": false }],
      "realmRoles": ["admin_access"]
    },
    {
      "username": "sim-user-0",
      "enabled": true,
